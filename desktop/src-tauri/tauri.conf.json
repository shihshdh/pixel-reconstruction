{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Reconstruction",
  "version": "1.2.0",
  "identifier": "app.pixelreconstruction.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Pixel Reconstruction",
    "copyright": "© 2026 Pixel Reconstruction",
    "shortDescription": "把一张照片重建成可以走进去的 3D 场景",
    "category": "Graphics and Design",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../../backend/local_engine/engine.py": "engine/engine.py",
      "../../backend/beam/gateway.py": "engine/gateway.py",
      "../../backend/beam/storage.py": "engine/storage.py",
      "../../backend/beam/security.py": "engine/security.py",
      "../../backend/beam/preview.py": "engine/preview.py",
      "../../backend/beam/mobile_preview.py": "engine/mobile_preview.py",
      "../../backend/beam/transfer.py": "engine/transfer.py",
      "../../backend/beam/run_sharp.py": "engine/run_sharp.py"
    }
  }
}
